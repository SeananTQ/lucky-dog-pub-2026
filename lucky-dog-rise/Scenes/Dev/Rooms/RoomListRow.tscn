[gd_scene format=3]

[ext_resource type="Script" path="res://Scripts/Dev/Rooms/RoomListRow.cs" id="script"]
[ext_resource type="Theme" path="res://Themes/DefaultTheme.tres" id="theme"]
[ext_resource type="Texture2D" path="res://Assets/UI/Icon/Dev/Icon_RoomGame.svg" id="icon"]

[node name="RoomListRow" type="HBoxContainer" node_paths=PackedStringArray("_gameIcon", "_name", "_count", "_join")]
layout_mode = 2
custom_minimum_size = Vector2(0, 40)
theme = ExtResource("theme")
script = ExtResource("script")
_gameIcon = NodePath("GameIcon")
_name = NodePath("Name")
_count = NodePath("Count")
_join = NodePath("Join")

[node name="GameIcon" type="TextureRect" parent="."]
layout_mode = 2
custom_minimum_size = Vector2(32, 32)
texture = ExtResource("icon")
expand_mode = 1
stretch_mode = 5

[node name="Name" type="Label" parent="."]
layout_mode = 2
size_flags_horizontal = 3
text = "房间"
text_overrun_behavior = 3

[node name="Count" type="Label" parent="."]
layout_mode = 2
custom_minimum_size = Vector2(38, 0)
text = "0/6"

[node name="Join" type="Button" parent="."]
theme_type_variation = &"CapsuleButton"
layout_mode = 2
custom_minimum_size = Vector2(60, 36)
text = "加入"
