[gd_scene format=3]

[ext_resource type="Script" path="res://Scripts/Rooms/Presentation/Poker/RoomPokerPanelView.cs" id="script"]
[ext_resource type="Theme" path="res://Themes/DefaultTheme.tres" id="theme"]

[node name="PokerSession" type="VBoxContainer" node_paths=PackedStringArray("_title", "_summary", "_orderHeading", "_order", "_resultHeading", "_result", "_error", "_next")]
theme = ExtResource("theme")
theme_override_constants/separation = 4
script = ExtResource("script")
_title = NodePath("Title")
_summary = NodePath("Summary")
_orderHeading = NodePath("TurnOrder/Heading")
_order = NodePath("TurnOrder/Order")
_resultHeading = NodePath("ResultHeading")
_result = NodePath("Results/Content/Result")
_error = NodePath("Results/Content/Error")
_next = NodePath("Next")

[node name="Title" type="Label" parent="."]
layout_mode = 2
auto_translate_mode = 2
autowrap_mode = 3
theme_type_variation = &"RoomPokerPanelTitle"

[node name="Summary" type="Label" parent="."]
layout_mode = 2
auto_translate_mode = 2
autowrap_mode = 3
theme_type_variation = &"RoomPokerPanelLabel"

[node name="TurnOrder" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 2

[node name="Heading" type="Label" parent="TurnOrder"]
layout_mode = 2
auto_translate_mode = 2
theme_type_variation = &"RoomPokerSectionHeading"

[node name="Order" type="Label" parent="TurnOrder"]
layout_mode = 2
auto_translate_mode = 2
autowrap_mode = 3
theme_type_variation = &"RoomPokerPanelLabel"

[node name="Separator" type="HSeparator" parent="."]
layout_mode = 2

[node name="ResultHeading" type="Label" parent="."]
layout_mode = 2
auto_translate_mode = 2
theme_type_variation = &"RoomPokerSectionHeading"

[node name="Results" type="ScrollContainer" parent="."]
custom_minimum_size = Vector2(0, 96)
layout_mode = 2
horizontal_scroll_mode = 0

[node name="Content" type="VBoxContainer" parent="Results"]
layout_mode = 2
size_flags_horizontal = 3

[node name="Result" type="Label" parent="Results/Content"]
layout_mode = 2
auto_translate_mode = 2
autowrap_mode = 3
theme_type_variation = &"RoomPokerPanelLabel"

[node name="Next" type="Button" parent="."]
visible = false
layout_mode = 2
theme_type_variation = &"CapsuleButton"
auto_translate_mode = 2
focus_mode = 0

[node name="Error" type="Label" parent="Results/Content"]
layout_mode = 2
auto_translate_mode = 2
autowrap_mode = 3
theme_type_variation = &"RoomPokerSmallLabel"
