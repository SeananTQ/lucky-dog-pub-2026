<Window x:Class="LuckyStats.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LuckyStats.Desktop"
        Title="Lucky Dog Rise · 玩家统计分析" Width="1220" Height="800"
        MinWidth="980" MinHeight="650" Background="{StaticResource PageBrush}"
        Loaded="OnLoaded" Closed="OnClosed">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="玩家统计分析" FontSize="26" FontWeight="SemiBold" Foreground="#263238" />
                <TextBlock Text="Steam 累计事实 → 成熟样本指标 → 关系校验" Foreground="#65737A" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="RefreshButton" Content="读取本地快照" Click="OnRefreshClick" />
                <Button x:Name="SyncButton" Content="从 Steam 同步" Click="OnSyncClick"
                        Background="{StaticResource AccentBrush}" Foreground="White" />
                <Button x:Name="ExportButton" Content="导出当前分析" Click="OnExportClick" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="White" BorderBrush="#D8DEE4" BorderThickness="1"
                CornerRadius="4" Padding="10,7" Margin="0,0,0,12">
            <DockPanel>
                <TextBlock x:Name="StatusText" Text="正在初始化…" Foreground="#455A64" />
                <TextBlock x:Name="CapturedAtText" DockPanel.Dock="Right" Foreground="#65737A" />
            </DockPanel>
        </Border>

        <TabControl Grid.Row="2">
            <TabItem Header="分析结论">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3*" />
                        <RowDefinition Height="2*" />
                    </Grid.RowDefinitions>
                    <GroupBox Header="自动计算指标" Margin="0,0,0,8">
                        <DataGrid x:Name="MetricsGrid" ItemsSource="{Binding Metrics}" />
                    </GroupBox>
                    <GroupBox Grid.Row="1" Header="关系校验与警告">
                        <DataGrid x:Name="ChecksGrid" ItemsSource="{Binding Checks}" />
                    </GroupBox>
                </Grid>
            </TabItem>

            <TabItem Header="事实表">
                <Grid Margin="10">
                    <DataGrid x:Name="FactsGrid" ItemsSource="{Binding Facts}" />
                </Grid>
            </TabItem>

            <TabItem Header="历史趋势">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="3*" />
                        <RowDefinition Height="2*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="统计项" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox x:Name="HistoryStatCombo" Width="420" DisplayMemberPath="DisplayLabel"
                                  SelectionChanged="OnHistoryStatChanged" />
                        <TextBlock Text="曲线使用扣除启用开发帐号后的累计净值" Foreground="#65737A"
                                   VerticalAlignment="Center" Margin="14,0,0,0" />
                    </StackPanel>
                    <local:TrendChart x:Name="HistoryChart" Grid.Row="1" Margin="0,0,0,8" />
                    <DataGrid x:Name="HistoryGrid" Grid.Row="2" />
                </Grid>
            </TabItem>

            <TabItem Header="指定玩家">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="SteamID64" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox x:Name="SteamIdText" Width="260" Padding="6" />
                        <Button Content="查询并保存快照" Click="OnQueryUserClick" />
                        <TextBlock Text="这里只能查询已知 SteamID，不会取得全部玩家名单。" Foreground="#65737A"
                                   VerticalAlignment="Center" Margin="12,0,0,0" />
                    </StackPanel>
                    <DataGrid x:Name="UserGrid" Grid.Row="1" />
                </Grid>
            </TabItem>

            <TabItem Header="数据位置">
                <Grid Margin="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Playtest AppID" Margin="0,6" />
                    <TextBlock Grid.Column="1" Text="4972240" Margin="0,6" />
                    <TextBlock Grid.Row="1" Text="统计定义" Margin="0,6" />
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="DefinitionsPathText" IsReadOnly="True" Padding="5" />
                    <TextBlock Grid.Row="2" Text="SQLite 数据库" Margin="0,6" />
                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="DatabasePathText" IsReadOnly="True" Padding="5" />
                    <TextBlock Grid.Row="3" Text="默认导出目录" Margin="0,6" />
                    <TextBox Grid.Row="3" Grid.Column="1" x:Name="ExportPathText" IsReadOnly="True" Padding="5" />
                    <TextBlock Grid.Row="4" Text="开发帐号来源" Margin="0,6" />
                    <TextBox Grid.Row="4" Grid.Column="1" x:Name="AllowlistPathText" IsReadOnly="True" Padding="5" />
                    <TextBlock Grid.Row="5" Grid.ColumnSpan="2" Margin="0,16,0,0" TextWrapping="Wrap"
                               Foreground="#65737A"
                               Text="Web API Key 仅从本机 .local-build 密钥文件读取，并通过 x-webapi-key 请求头发送。界面、SQLite、CSV、JSON 和命令行输出均不保存或显示 Key。原始 Steam JSON 保存在 SQLite 中，用于回查每次计算依据。" />
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
