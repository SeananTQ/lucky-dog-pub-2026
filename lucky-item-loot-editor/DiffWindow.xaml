<Window x:Class="LuckyItemLootEditor.DiffWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Git Diff"
        Width="1000"
        Height="700"
        MinWidth="700"
        MinHeight="400">
  <Grid Margin="10">
    <TextBox Text="{Binding DiffText}" IsReadOnly="True" AcceptsReturn="True" AcceptsTab="True"
             FontFamily="Consolas" FontSize="13" HorizontalScrollBarVisibility="Auto"
             VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap" />
  </Grid>
</Window>
