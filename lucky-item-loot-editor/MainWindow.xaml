<Window x:Class="LuckyItemLootEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lucky Item Loot Editor"
        Width="1500"
        Height="850"
        MinWidth="1100"
        MinHeight="650"
        Loaded="Window_Loaded">
  <Window.Resources>
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Padding" Value="8,5" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style TargetType="TextBlock" x:Key="MutedText">
      <Setter Property="Foreground" Value="#666" />
    </Style>
  </Window.Resources>

  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" LastChildFill="True">
      <StackPanel DockPanel.Dock="Left">
        <TextBlock FontSize="24" FontWeight="SemiBold">Lucky Item Loot Editor</TextBlock>
        <TextBlock Margin="0,3,0,0" Style="{StaticResource MutedText}"
                   Text="编辑 tbItem.json 的稀有度、获取类型和盲盒权重" />
      </StackPanel>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
        <Button Width="90" Margin="6,0,0,0" Padding="8,5" Click="ReloadButton_Click">重新加载</Button>
        <Button Width="90" Margin="6,0,0,0" Padding="8,5" Click="SaveButton_Click">保存 JSON</Button>
      </StackPanel>
    </DockPanel>

    <Grid Grid.Row="1" Margin="0,14,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="340" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="240" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">当前盲盒</TextBlock>
      <ComboBox Grid.Column="1" ItemsSource="{Binding BlindBoxes}" SelectedItem="{Binding SelectedBlindBox}"
                DisplayMemberPath="DisplayName" SelectionChanged="BlindBoxComboBox_SelectionChanged" />
      <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="18,0,8,0">筛选</TextBlock>
      <TextBox Grid.Column="3" Height="28" VerticalContentAlignment="Center" TextChanged="SearchTextBox_TextChanged" />
      <TextBlock Grid.Column="4" Margin="18,0,0,0" VerticalAlignment="Center" Style="{StaticResource MutedText}"
                 Text="{Binding SelectedWeightFieldLabel, StringFormat=当前编辑字段：{0}}" />
      <Button Grid.Column="5" Width="100" Padding="8,5" Click="RandomButton_Click">随机一次</Button>
    </Grid>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="300" />
      </Grid.ColumnDefinitions>

      <DataGrid Grid.Column="0" ItemsSource="{Binding ItemsView}" SelectedItem="{Binding SelectedItem}"
                AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False"
                SelectionMode="Single" SelectionUnit="FullRow" EnableRowVirtualization="True"
                GridLinesVisibility="Horizontal" HeadersVisibility="Column">
        <DataGrid.Columns>
          <DataGridTemplateColumn Header="图标" Width="64" IsReadOnly="True">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Border Width="48" Height="48" Background="#F2F2F2" CornerRadius="4">
                  <Grid Width="48" Height="48">
                    <Image Source="{Binding RarityPlate}" Width="48" Height="48" Stretch="Uniform" />
                    <Image Source="{Binding Icon}" Width="42" Height="42" Stretch="Uniform" />
                    <Image Source="{Binding RarityFrame}" Width="48" Height="48" Stretch="Uniform" />
                  </Grid>
                </Border>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="70" IsReadOnly="True" />
          <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="190" IsReadOnly="True" />
          <DataGridTemplateColumn Header="稀有度" Width="110">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <ComboBox ItemsSource="{Binding DataContext.RarityOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                          DisplayMemberPath="Label" SelectedValuePath="Value"
                          SelectedValue="{Binding Rarity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <Border Background="{Binding Background}" Padding="5,2" CornerRadius="3">
                        <TextBlock Text="{Binding Label}" Foreground="{Binding Foreground}" />
                      </Border>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="获取类型" Width="145">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <ComboBox ItemsSource="{Binding DataContext.AcquisitionOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                          DisplayMemberPath="Label" SelectedValuePath="Value"
                          SelectedValue="{Binding AcquisitionType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="当前权重" Binding="{Binding CurrentWeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="105">
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="TextBlock">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="VerticalAlignment" Value="Center" />
              </Style>
            </DataGridTextColumn.ElementStyle>
            <DataGridTextColumn.EditingElementStyle>
              <Style TargetType="TextBox">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
              </Style>
            </DataGridTextColumn.EditingElementStyle>
          </DataGridTextColumn>
          <DataGridTextColumn Header="稀有度概率" Binding="{Binding RarityProbability, StringFormat={}{0:P2}}" Width="105" IsReadOnly="True" />
          <DataGridTextColumn Header="同稀有度" Binding="{Binding WithinRarityProbability, StringFormat={}{0:P2}}" Width="105" IsReadOnly="True" />
          <DataGridTextColumn Header="预期概率" Binding="{Binding ExpectedProbability, StringFormat={}{0:P2}}" Width="100" IsReadOnly="True">
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="TextBlock">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="VerticalAlignment" Value="Center" />
              </Style>
            </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
          <DataGridTemplateColumn Header="候选状态" Width="120" IsReadOnly="True">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Border Background="{Binding CandidateStatusBackground}" CornerRadius="3" Padding="5,2">
                  <TextBlock Text="{Binding CandidateStatus}" Foreground="{Binding CandidateStatusForeground}" />
                </Border>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>

      <ScrollViewer Grid.Column="1" Margin="12,0,0,0" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <Border Padding="12" BorderBrush="#DDD" BorderThickness="1" CornerRadius="6">
            <StackPanel>
              <TextBlock FontSize="16" FontWeight="SemiBold">选中物品</TextBlock>
              <Grid Width="150" Height="150" Margin="0,12">
                <Image Source="{Binding SelectedItem.RarityPlate}" Width="150" Height="150" Stretch="Uniform" />
                <Image Source="{Binding SelectedItem.Icon}" Width="132" Height="132" Stretch="Uniform" />
                <Image Source="{Binding SelectedItem.RarityFrame}" Width="150" Height="150" Stretch="Uniform" />
              </Grid>
              <TextBlock Text="{Binding SelectedItem.Name}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock Margin="0,5,0,0" Style="{StaticResource MutedText}"
                         Text="{Binding SelectedItem.IconPath}" TextWrapping="Wrap" />
              <Separator Margin="0,12" />
              <TextBlock Text="{Binding SelectedItem.RarityProbability, StringFormat=稀有度概率：{0:P2}}" />
              <TextBlock Margin="0,5,0,0" Text="{Binding SelectedItem.WithinRarityProbability, StringFormat=同稀有度概率：{0:P2}}" />
              <TextBlock Margin="0,5,0,0" Text="{Binding SelectedItem.ExpectedProbability, StringFormat=最终预期概率：{0:P2}}" />
              <Border Margin="0,8,0,0" Background="{Binding SelectedItem.CandidateStatusBackground}" CornerRadius="3" Padding="6,3">
                <TextBlock Text="{Binding SelectedItem.CandidateStatus, StringFormat=状态：{0}}"
                           Foreground="{Binding SelectedItem.CandidateStatusForeground}" />
              </Border>
            </StackPanel>
          </Border>

          <Border Margin="0,12,0,0" Padding="12" BorderBrush="#DDD" BorderThickness="1" CornerRadius="6">
            <StackPanel>
              <TextBlock FontSize="16" FontWeight="SemiBold">随机结果</TextBlock>
              <Grid Width="150" Height="150" Margin="0,12">
                <Image Source="{Binding RandomResultItem.RarityPlate}" Width="150" Height="150" Stretch="Uniform" />
                <Image Source="{Binding RandomResultItem.Icon}" Width="132" Height="132" Stretch="Uniform" />
                <Image Source="{Binding RandomResultItem.RarityFrame}" Width="150" Height="150" Stretch="Uniform" />
              </Grid>
              <TextBlock Text="{Binding RandomResultText}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <TextBlock Grid.Row="3" Margin="0,10,0,0" Style="{StaticResource MutedText}" Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" />
  </Grid>
</Window>
